  "outputCatalog": {
    "system-validation": {
      "kind": "record",
      "description": "Validation evidence for the toolchain's intended use."
    },
    "verification-records": {
      "kind": "record",
      "description": "`quire matrix` / `quoin matrix` results and `quoin evidence record`; rendered by `quoin dossier generate --doc verification-report` and `--doc trace-matrix`."
    },
    "audit-trail": {
      "kind": "record",
      "description": "Git history and signed-approval history produced by the `approval-trail` capability for the record."
    },
    "access-control": {
      "kind": "record",
      "description": "Repository permission and branch-rule settings."
    },
    "written-procedure": {
      "kind": "procedure",
      "description": "Customer-owned written procedure."
    },
    "training-record": {
      "kind": "procedure",
      "description": "Customer-owned training record."
    },
    "signed-record": {
      "kind": "record",
      "description": "Signed commits and tags verified by the `signature-verify` capability."
    },
    "signer-registry": {
      "kind": "record",
      "description": "Allowed-signers mapping from signing key to named person, read by the `approval-trail` capability."
    },
    "signature-meaning": {
      "kind": "record",
      "description": "The `Signed-off-meaning:` trailer verified by the `approval-verify` capability."
    },
    "approval-trail": {
      "kind": "record",
      "description": "Signed approval history for a record produced by the `approval-trail` capability."
    },
    "fda-certification-record": {
      "kind": "record",
      "description": "Evidence that the electronic-signature certification was submitted to FDA."
    }
  },
